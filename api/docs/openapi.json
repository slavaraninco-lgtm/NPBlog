{
  "openapi": "3.1.0",
  "info": {
    "title": "NPBlog Mobile REST API",
    "description": "Полный REST API редактора и системы управления контентом NPBlog для мобильных приложений (iOS, Android, Flutter, React Native). Включает Bearer-аутентификацию, управление статьями, версионирование (бэкапы), черновики, автосохранения, медиа-хранилище, шаблоны, сниппеты, настройки блога и системную диагностику.",
    "version": "1.0.0",
    "contact": {
      "name": "NPBlog Core Team"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Локальный сервер API"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token",
        "description": "Токен авторизации, полученный в эндпоинте POST /api/v1/auth/login. Передавать в заголовке: Authorization: Bearer <access_token>"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "status": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "Операция выполнена успешно" },
          "data": { "type": "object" },
          "meta": { "type": "object" }
        },
        "required": ["success", "status"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "status": { "type": "integer", "example": 400 },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "invalid_credentials" },
              "message": { "type": "string", "example": "Неверный пароль" },
              "details": { "type": "object" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["success", "status", "error"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "password": { "type": "string", "description": "Пароль доступа к редактору", "example": "mySecretPass" },
          "device_name": { "type": "string", "description": "Имя мобильного устройства", "example": "iPhone 15 Pro Max" }
        },
        "required": ["password"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "example": "npb_7f8a9b2c3d4e5f6..." },
          "token_type": { "type": "string", "example": "Bearer" },
          "token_id": { "type": "string", "example": "tok_12345678" },
          "device_name": { "type": "string", "example": "iPhone 15 Pro Max" },
          "expires_at": { "type": "integer", "example": 1791735000 },
          "expires_in": { "type": "integer", "example": 2592000 },
          "created_at": { "type": "integer", "example": 1789143000 }
        }
      },
      "PostItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Моя первая статья" },
          "date": { "type": "string", "example": "11.09.2026 19:30" },
          "filename": { "type": "string", "example": "post-1.html" },
          "url": { "type": "string", "example": "/data/blog/post-1.html" }
        }
      },
      "PostDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Моя первая статья" },
          "date": { "type": "string", "example": "11.09.2026 19:30" },
          "filename": { "type": "string", "example": "post-1.html" },
          "content": { "type": "string", "description": "HTML-содержимое статьи для редактора", "example": "<p>Текст статьи...</p>" },
          "background": { "type": "object", "nullable": true },
          "url": { "type": "string", "example": "/data/blog/post-1.html" }
        }
      },
      "PostCreateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Заголовок статьи", "example": "Новая статья из мобильного приложения" },
          "content": { "type": "string", "description": "HTML контент статьи", "example": "<p>Привет из мобильного приложения!</p>" },
          "date": { "type": "string", "description": "Дата публикации (необязательно)", "example": "11.09.2026 19:30" }
        },
        "required": ["title", "content"]
      },
      "DraftItem": {
        "type": "object",
        "properties": {
          "filename": { "type": "string", "example": "1789144000.json" },
          "title": { "type": "string", "example": "Набросок новой статьи" },
          "content": { "type": "string", "example": "<p>Черновой текст...</p>" },
          "timestamp": { "type": "integer", "example": 1789144000 },
          "date": { "type": "string", "example": "2026-09-11 19:30:00" }
        }
      },
      "AutosaveItem": {
        "type": "object",
        "properties": {
          "post_id": { "type": "string", "example": "1" },
          "title": { "type": "string", "example": "Статья 1" },
          "content": { "type": "string", "example": "<p>Автосохраненный текст...</p>" },
          "timestamp": { "type": "integer", "example": 1789144000 },
          "date": { "type": "string", "example": "11.09.2026 19:30:00" }
        }
      },
      "MediaItem": {
        "type": "object",
        "properties": {
          "filename": { "type": "string", "example": "m_6a8c3d.jpg" },
          "type": { "type": "string", "enum": ["images", "video", "audio", "documents", "fonts"], "example": "images" },
          "extension": { "type": "string", "example": "jpg" },
          "size": { "type": "integer", "example": 1048576 },
          "uploaded_at": { "type": "integer", "example": 1789144000 },
          "date": { "type": "string", "example": "11.09.2026 19:30" },
          "url": { "type": "string", "example": "/data/uploads/m_6a8c3d.jpg" }
        }
      },
      "MediaUploadRequest": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "format": "binary", "description": "Бинарный файл при multipart/form-data передаче" },
          "base64": { "type": "string", "description": "Base64-строка файла (альтернатива multipart для мобильных)", "example": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUg..." },
          "filename": { "type": "string", "description": "Оригинальное имя файла для Base64", "example": "photo.png" },
          "type": { "type": "string", "enum": ["image", "video", "audio", "document", "font"], "description": "Категория загружаемого файла", "example": "image" }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Информация об API и корневой статус",
        "security": [],
        "responses": {
          "200": { "description": "Успешный ответ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Авторизация и получение Bearer токена",
        "description": "Проверяет пароль доступа, регистрирует мобильное устройство и возвращает Bearer-токен на 30 дней. Защищен от брутфорса (блокировка на 15 мин после 3 неверных попыток).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Токен успешно выдан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Неверный пароль", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "429": { "description": "IP временно заблокирован из-за превышения попыток", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Выход и отзыв текущего токена",
        "responses": {
          "200": { "description": "Токен отозван", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "summary": "Проверка авторизации и текущего токена",
        "responses": {
          "200": { "description": "Данные текущей сессии", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Не авторизован", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/v1/auth/tokens": {
      "get": {
        "summary": "Список активных мобильных устройств и сессий",
        "responses": {
          "200": { "description": "Список сессий", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/auth/tokens/{id}": {
      "delete": {
        "summary": "Отзыв токена конкретного устройства",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "ID токена (например tok_5588d87a8c890fba)" }
        ],
        "responses": {
          "200": { "description": "Токен отозван", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/auth/change-password": {
      "post": {
        "summary": "Смена пароля администратора",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "current_password": { "type": "string" },
                  "new_password": { "type": "string", "minLength": 6 }
                },
                "required": ["new_password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Пароль изменен" }
        }
      }
    },
    "/v1/posts": {
      "get": {
        "summary": "Список статей с пагинацией и поиском",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Номер страницы" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Количество на странице (1-100)" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Поисковый запрос по названию" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["id_desc", "id_asc", "date_desc", "date_asc"], "default": "id_desc" } }
        ],
        "responses": {
          "200": { "description": "Список статей", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Создание новой статьи",
        "description": "Создает HTML-файл статьи из активного шаблона, обновляет posts-meta.json, создает версию бэкапа 1 и генерирует RSS ленту.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PostCreateRequest" } }
          }
        },
        "responses": {
          "201": { "description": "Статья создана", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/posts/{id}": {
      "get": {
        "summary": "Получение содержимого и метаданных статьи",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Данные статьи", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "404": { "description": "Статья не найдена" }
        }
      },
      "put": {
        "summary": "Обновление статьи",
        "description": "Обновляет HTML статьи, создает инкрементный бэкап и перегенерирует RSS.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PostCreateRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Статья обновлена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "summary": "Удаление статьи",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "renumber", "in": "query", "schema": { "type": "boolean", "default": false }, "description": "Автоматически перенумеровать статьи" }
        ],
        "responses": {
          "200": { "description": "Статья удалена" }
        }
      }
    },
    "/v1/posts/{id}/preview": {
      "get": {
        "summary": "Готовый HTML-предпросмотр статьи для мобильного WebView",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "HTML разметка статьи", "content": { "text/html": {} } }
        }
      }
    },
    "/v1/posts/renumber": {
      "post": {
        "summary": "Сквозная перенумерация всех статей блога",
        "responses": {
          "200": { "description": "Результат перенумерации" }
        }
      }
    },
    "/v1/posts/regenerate": {
      "post": {
        "summary": "Перегенерация всех HTML-статей блога из шаблонов",
        "responses": {
          "200": { "description": "Количество обновленных статей" }
        }
      }
    },
    "/v1/drafts": {
      "get": {
        "summary": "Список всех черновиков",
        "responses": {
          "200": { "description": "Массив черновиков" }
        }
      },
      "post": {
        "summary": "Сохранение нового черновика",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Черновик сохранен" }
        }
      }
    },
    "/v1/drafts/{filename}": {
      "get": {
        "summary": "Получение содержимого черновика",
        "parameters": [
          { "name": "filename", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Черновик" }
        }
      },
      "delete": {
        "summary": "Удаление черновика",
        "parameters": [
          { "name": "filename", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Удален" }
        }
      }
    },
    "/v1/autosaves": {
      "get": {
        "summary": "Список всех автосохранений",
        "responses": {
          "200": { "description": "Массив автосохранений" }
        }
      },
      "delete": {
        "summary": "Очистка всех автосохранений",
        "responses": {
          "200": { "description": "Очищено" }
        }
      },
      "post": {
        "summary": "Сохранение состояния автосохранения",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "post_id": { "type": "string", "example": "1" },
                  "title": { "type": "string" },
                  "content": { "type": "string" }
                },
                "required": ["post_id", "content"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Сохранено" }
        }
      }
    },
    "/v1/autosaves/{postId}": {
      "get": {
        "summary": "Получение автосохранения конкретной статьи",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Данные автосохранения" }
        }
      },
      "delete": {
        "summary": "Удаление автосохранения статьи",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Удалено" }
        }
      }
    },
    "/v1/backups": {
      "get": {
        "summary": "Реестр всех резервных копий по статьям",
        "responses": {
          "200": { "description": "Реестр бэкапов" }
        }
      }
    },
    "/v1/backups/{postId}": {
      "get": {
        "summary": "Список резервных копий статьи",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Версии статьи" }
        }
      }
    },
    "/v1/backups/{postId}/{backupNumber}": {
      "get": {
        "summary": "Просмотр содержимого конкретной версии бэкапа",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "backupNumber", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Контент бэкапа" }
        }
      },
      "delete": {
        "summary": "Удаление версии бэкапа",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "backupNumber", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Удалено" }
        }
      }
    },
    "/v1/backups/{postId}/{backupNumber}/restore": {
      "post": {
        "summary": "Откат статьи к выбранной версии бэкапа",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "backupNumber", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Статья восстановлена" }
        }
      }
    },
    "/v1/media": {
      "get": {
        "summary": "Список медиафайлов с фильтрацией по типу",
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["all", "images", "video", "audio", "documents", "fonts"], "default": "all" } }
        ],
        "responses": {
          "200": { "description": "Массив медиафайлов" }
        }
      },
      "delete": {
        "summary": "Удаление медиафайла",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filename": { "type": "string" },
                  "type": { "type": "string", "enum": ["images", "video", "audio", "documents", "fonts"] }
                },
                "required": ["filename"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Файл удален" }
        }
      }
    },
    "/v1/media/upload": {
      "post": {
        "summary": "Универсальная загрузка медиафайлов",
        "description": "Поддерживает как передачу multipart/form-data (поле `file`), так и передачу Base64 строки в JSON (`base64`, `filename`, `type`). Идеально подходит для мобильных камер и фотогалерей.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/MediaUploadRequest" }
            },
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MediaUploadRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Файл загружен", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/v1/media/backgrounds": {
      "get": {
        "summary": "Список настроек фонов статей",
        "responses": { "200": { "description": "Фоны" } }
      },
      "post": {
        "summary": "Установка индивидуального фона для статьи",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "post_id": { "type": "integer" },
                  "background": { "type": "string", "example": "/data/uploads/bg.jpg" },
                  "repeat": { "type": "string", "example": "no-repeat" },
                  "size": { "type": "string", "example": "cover" },
                  "position": { "type": "string", "example": "center" },
                  "overlay_color": { "type": "string", "example": "#000000" },
                  "overlay_opacity": { "type": "number", "example": 0.5 }
                },
                "required": ["post_id", "background"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Фон установлен" } }
      }
    },
    "/v1/media/backgrounds/{postId}": {
      "delete": {
        "summary": "Удаление фона статьи",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "integer" } }
