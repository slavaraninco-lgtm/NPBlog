# REST API Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Handle preflight CORS requests immediately if needed
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ index.php [QSA,L]

    # Don't rewrite existing files or directories (like api/docs/ or static files)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?_route=$1 [QSA,L]
</IfModule>
