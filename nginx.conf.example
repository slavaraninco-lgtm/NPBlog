# ==============================================================================
# Конфигурация Nginx для NPBlog (Go-сервер + REST API + SSE)
# ==============================================================================
# Инструкция по установке на Ubuntu / Debian:
# 1. Скопируйте этот файл в конфигурацию Nginx:
#    sudo cp nginx.conf.example /etc/nginx/sites-available/npblog
# 2. Отредактируйте server_name и порт Go-бэкенда под ваш сервер:
#    sudo nano /etc/nginx/sites-available/npblog
# 3. Активируйте сайт и перезапустите Nginx:
#    sudo ln -s /etc/nginx/sites-available/npblog /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

# Поддержка WebSocket/Upgrade соединений
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-blog-domain.com; # Укажите ваш домен или IP-адрес сервера

    root /var/www/html; # Укажите путь к папке блога на сервере

    # Максимальный размер загружаемых файлов (фото, видео, шрифты, резервные копии)
    client_max_body_size 64M;

    charset utf-8;

    # --------------------------------------------------------------------------
    # 1. БЕЗОПАСНОСТЬ: ЗАЩИТА СЛУЖЕБНЫХ ФАЙЛОВ И ТОКЕНОВ (АНАЛОГ ROOT .HTACCESS)
    # --------------------------------------------------------------------------
    # Запрет доступа к скрытым файлам (.git, .env, .htaccess и т.д.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Запрет прямого доступа к файлам токенов, настроек и системным логам
    location ~* /(editor_settings\.json|allowed_ips\.txt|ftp\.json|version\.json|history\.json|backup-meta\.json|includes-meta\.json|login_lockouts\.json|api_tokens\.json|\.(bak|log|sql|dist|sh|bat|cmd|ini))$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Запрет доступа к служебным папкам резервных копий
    location ~* ^/(data_backup|editor_backup|sys_update_tmp|rollback_tmp)/ {
        deny all;
    }

    # --------------------------------------------------------------------------
    # 2. ПРЯМАЯ РАЗДАЧА СТАТИЧЕСКИХ МЕДИАФАЙЛОВ ИЗ ПАПКИ /data/
    # --------------------------------------------------------------------------
    location ~* ^/data/.*\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|mp3|ogg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # --------------------------------------------------------------------------
    # 3. ПРОКСИРОВАНИЕ НА GO-СЕРВЕР NPBLOG (ВКЛЮЧАЯ REST API И SSE СТРИМИНГ)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket / Connection Upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Поддержка SSE (Server-Sent Events) для потоковой синхронизации без буферизации
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
